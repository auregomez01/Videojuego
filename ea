
Jugador jugador;
Bot bot;

ArrayList<Hielo> hielos;
ArrayList<Laguna> lagunas;
ArrayList<Fuego> fuegos;
ArrayList<Zanahoria> zanahorias;
ArrayList<Medalla> medallas;

int zanahoriasAgarradas = 0;
int medallasAgarradas = 0;

boolean segundaOleada = false;
boolean juegoTerminado = false;

String mensajeMuerte = "";

// MENU PRINCIPAL

PImage fondoMenu;

int pantalla = 0; // 0 = menu, 1 = juego

String nombreUsuario = "";
boolean escribiendoNombre = false;
String mensajeMenu = "";


void setup() {
  size(1000, 600);

  fondoMenu = loadImage("menu.jpg");

  if (fondoMenu == null) {
    println("No se encontro menu.jpg. Revisá la carpeta data.");
  }

  inicializarObjetos();
  crearMapaLagunas();
  crearColeccionables();
}


void draw() {

  if (pantalla == 0) {
    mostrarMenu();
    return;
  }

  if (juegoTerminado) {
    mostrarPantallaMuerte();
    return;
  }

  background(0);
  dibujarPuntaje();
  actualizarJugador();
  actualizarBot();
  mostrarMapa();
  actualizarColeccionables();

  if (verificarVictoria()) {
    return;
  }

  actualizarHielos();
  actualizarFuegos();

  if (juegoTerminado) {
    return;
  }

  verificarDerrota();
}


// MENU

void mostrarMenu() {

  if (fondoMenu != null) {
    imageMode(CORNER);
    image(fondoMenu, 0, 0, width, height);
  } else {
    background(30, 120, 110);
  }

  textAlign(CENTER, CENTER);
  fill(75, 30, 25);
  textSize(25);
  text("AVENTURA HELADA", 500, 190);

  // NOMBRE DE USUARIO

  fill(75, 30, 25);
  textSize(15);
  text("NOMBRE DE USUARIO", 500, 222);

  rectMode(CENTER);
  stroke(80, 40, 25);
  strokeWeight(2);
  fill(255, 238, 205);
  rect(500, 255, 270, 38, 8);

  fill(65, 35, 25);
  textSize(15);

  if (nombreUsuario.length() == 0) {
    text("Escribi tu nombre...", 500, 255);
  } else {
    text(nombreUsuario, 500, 255);
  }

  if (escribiendoNombre) {
    noFill();
    stroke(255, 230, 120);
    strokeWeight(3);
    rect(500, 255, 278, 46, 9);
  }

  // INSTRUCCIONES

  fill(75, 30, 25);
  textSize(19);
  text("¿COMO JUGAR?", 500, 300);

  textSize(15);
  text("FLECHAS: mover al conejo", 500, 328);
  text("ESPACIO: crear hielo", 500, 352);
  text("H: romper hielo", 500, 376);

  if (mensajeMenu.length() > 0) {
    fill(120, 25, 20);
    textSize(13);
    text(mensajeMenu, 500, 400);
  }

  // BOTON JUGAR

  boolean sobreBoton =
    mouseX > 390 && mouseX < 610 &&
    mouseY > 415 && mouseY < 465;

  if (sobreBoton) {
    fill(130, 190, 40);
  } else {
    fill(95, 155, 25);
  }

  stroke(55, 75, 20);
  strokeWeight(3);
  rect(500, 440, 220, 50, 12);

  fill(255);
  textSize(23);
  text("JUGAR", 500, 440);

  rectMode(CORNER);
}


// BOTONES E INTERACCIONES

void mousePressed() {

  if (pantalla == 0) {

    if (mouseX > 365 && mouseX < 635 &&
        mouseY > 236 && mouseY < 274) {

      escribiendoNombre = true;
      mensajeMenu = "";

    } else {
      escribiendoNombre = false;
    }

    if (mouseX > 390 && mouseX < 610 &&
        mouseY > 415 && mouseY < 465) {

      if (nombreUsuario.trim().length() > 0) {
        pantalla = 1;
        escribiendoNombre = false;
        mensajeMenu = "";

      } else {
        mensajeMenu = "Primero ingresá un nombre de usuario";
        escribiendoNombre = true;
      }
    }
  }
}


// TECLADO

void keyPressed() {

  if (pantalla == 0) {

    if (escribiendoNombre) {

      if (key == BACKSPACE) {

        if (nombreUsuario.length() > 0) {
          nombreUsuario = nombreUsuario.substring(
            0, nombreUsuario.length() - 1
          );
        }

      } else if (key == ENTER || key == RETURN) {

        escribiendoNombre = false;

      } else if (key != CODED &&
                 key >= 32 &&
                 key <= 126 &&
                 nombreUsuario.length() < 15) {

        nombreUsuario += key;
      }
    }

    return;
  }

  if (pantalla == 1 && !juegoTerminado) {

    if (key == ' ') {
      ponerHielo();
    }

    if (key == 'h' || key == 'H') {
      deshacerHielo();
    }
  }
}


// INICIALIZACION DEL JUEGO

void inicializarObjetos() {
  jugador = new Jugador();
  bot = new Bot();
  hielos = new ArrayList<Hielo>();
  lagunas = new ArrayList<Laguna>();
  fuegos = new ArrayList<Fuego>();
  zanahorias = new ArrayList<Zanahoria>();
  medallas = new ArrayList<Medalla>();
}


void crearColeccionables() {
  for (int i = 0; i < 3; i++) {
    PVector p = posicionSegura();
    zanahorias.add(new Zanahoria(p.x, p.y));
  }

  PVector pm = posicionSegura();
  medallas.add(new Medalla(pm.x, pm.y));
}


PVector posicionSegura() {
  int intentos = 0;

  while (intentos < 200) {
    float x = random(80, width - 80);
    float y = random(80, height - 80);
    PVector p = new PVector(x, y);

    boolean choca = false;

    for (Laguna laguna : lagunas) {
      if (PVector.dist(p, laguna.location) < 50) {
        choca = true;
        break;
      }
    }

    if (!choca) {
      return p;
    }

    intentos++;
  }

  return new PVector(random(80, width - 80), random(80, height - 80));
}


void crearMapaLagunas() {
  lagunas.clear();

  for (int i = 0; i < 4; i++) {
    lagunas.add(new Laguna(350, 100 + i * 130));
  }

  for (int i = 0; i < 4; i++) {
    lagunas.add(new Laguna(650, 100 + i * 130));
  }
}


// LOGICA DEL JUEGO

void actualizarJugador() {
  jugador.update();
  jugador.display();
}


void actualizarBot() {
  bot.update(jugador.location);
  bot.display();
}


void mostrarMapa() {
  for (Laguna laguna : lagunas) {
    laguna.display();
  }
}


void actualizarColeccionables() {
  actualizarZanahorias();
  actualizarMedallas();
  verificarSegundaOleada();
}


void actualizarZanahorias() {
  for (int i = zanahorias.size() - 1; i >= 0; i--) {
    Zanahoria z = zanahorias.get(i);
    z.display();

    if (PVector.dist(jugador.location, z.location) < 30) {
      zanahorias.remove(i);
      zanahoriasAgarradas++;
    }
  }
}


void actualizarMedallas() {
  for (int i = medallas.size() - 1; i >= 0; i--) {
    Medalla m = medallas.get(i);
    m.display();

    if (PVector.dist(jugador.location, m.location) < 30) {
      medallas.remove(i);
      medallasAgarradas++;
    }
  }
}


void verificarSegundaOleada() {
  if (!segundaOleada &&
      zanahorias.size() == 0 &&
      medallas.size() == 0 &&
      zanahoriasAgarradas == 3 &&
      medallasAgarradas == 1) {

    segundaOleada = true;

    for (int i = 0; i < 3; i++) {
      PVector p = posicionSegura();
      zanahorias.add(new Zanahoria(p.x, p.y));
    }

    for (int i = 0; i < 2; i++) {
      PVector p = posicionSegura();
      medallas.add(new Medalla(p.x, p.y));
    }
  }
}


boolean verificarVictoria() {
  if (zanahoriasAgarradas == 6 && medallasAgarradas == 3) {
    background(0, 150, 0);
    fill(255);
    textAlign(CENTER, CENTER);
    textSize(30);
    text("¡GANASTE!", width / 2, height / 2);
    noLoop();
    return true;
  }

  return false;
}


void mostrarPantallaMuerte() {
  background(150, 0, 0);
  fill(255);
  textAlign(CENTER, CENTER);
  textSize(30);
  text(mensajeMuerte, width / 2, height / 2);
}


void verificarDerrota() {
  if (bot.atrapo(jugador.location)) {
    juegoTerminado = true;
    mensajeMuerte = "¡TE ATRAPO!";
  }
}


void actualizarHielos() {
  for (int i = hielos.size() - 1; i >= 0; i--) {
    Hielo h = hielos.get(i);
    h.update();
    h.display();

    if (h.derritiendo) {
      h.tiempoFuego++;

      if (h.tiempoFuego >= 90) {
        hielos.remove(i);
      }
    }
  }
}


void actualizarFuegos() {
  for (int i = fuegos.size() - 1; i >= 0; i--) {
    Fuego f = fuegos.get(i);
    f.update();
    f.display();

    if (PVector.dist(f.location, jugador.location) < 28) {
      juegoTerminado = true;
      mensajeMuerte = "¡TE QUEMO EL FUEGO!";
      return;
    }

    boolean golpeo = false;

    for (int j = hielos.size() - 1; j >= 0; j--) {
      Hielo h = hielos.get(j);

      if (h.chocaCon(f.location)) {
        h.derritiendo = true;
        golpeo = true;
        break;
      }
    }

    if (golpeo) {
      fuegos.remove(i);
    } else if (f.fueraDePantalla()) {
      fuegos.remove(i);
    }
  }
}


void dibujarPuntaje() {
  fill(255);
  textAlign(LEFT, TOP);
  textSize(14);

  text("Jugador: " + nombreUsuario, 10, 10);
  text("Zanahorias: " + zanahoriasAgarradas + "/6", 10, 30);
  text("ESPACIO: poner hielo | H: deshacer hielo", 10, 50);

  for (int i = 0; i < 3; i++) {
    float x = width - 35 - i * 40;
    float y = 25;

    stroke(255, 200, 0);
    strokeWeight(4);

    if (i < medallasAgarradas) {
      fill(255, 255, 0);
    } else {
      fill(60);
    }

    ellipse(x, y, 30, 30);
  }
}


